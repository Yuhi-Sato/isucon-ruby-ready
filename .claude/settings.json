{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git checkout -b*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/issue-sync-before-branch.sh",
            "timeout": 30,
            "statusMessage": "issueの競合を確認中..."
          },
          {
            "type": "command",
            "if": "Bash(git switch -c*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/issue-sync-before-branch.sh",
            "timeout": 30,
            "statusMessage": "issueの競合を確認中..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/issue-sync-after-pr-create.sh",
            "timeout": 30,
            "statusMessage": "issue-syncを確認中..."
          }
        ]
      }
    ]
  }
}
