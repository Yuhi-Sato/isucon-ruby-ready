{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pr-body-before-commit.sh",
            "timeout": 30,
            "statusMessage": "PR本文を確認中..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh issue create*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/issue-sync-after-pr-create.sh",
            "timeout": 30,
            "statusMessage": "IssueSyncを確認中..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/create-pr-on-stop.sh",
            "timeout": 30,
            "statusMessage": "PRの有無を確認中..."
          }
        ]
      }
    ]
  }
}
