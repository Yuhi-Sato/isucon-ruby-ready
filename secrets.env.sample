# このファイルをコピーして secrets.env として使う（`.gitignore`済みなので誤コミットしない）。
#
#   cp secrets.env.sample secrets.env
#
# APIキーやDiscord webhookなど、env.shと違ってgit管理に一切乗せたくない値をここに書く。
# make distribute-secrets で全サーバーへSSH配布する（README「secrets.envの配布」参照）。

# Discord Webhook（make nd / notify-discord-alp / notify-discord-slow-query が使う）
# alp / slow-query で共通のWebhookを使う場合はこれだけ設定すればよい。
# Discordチャンネルの設定 > 連携サービス > ウェブフック で URL を発行する。
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/XXXX/XXXX"

# alp / slow-query でチャンネルや投稿者名を分けたい場合はコメントを外して個別に上書きする
# （未設定時のusernameは alp / slow-query になる）
#DISCORD_WEBHOOK_URL_ALP="https://discord.com/api/webhooks/XXXX/XXXX"
#DISCORD_WEBHOOK_URL_SLOW_QUERY="https://discord.com/api/webhooks/XXXX/XXXX"
#DISCORD_USERNAME_ALP="alp"
#DISCORD_USERNAME_SLOW_QUERY="slow-query"

# 各サーバーのIPアドレス（アプリ/DBを複数台に分離する際、nginxのupstreamやDBの接続先に使う）。
# ~/.ssh/configのHost別名（s1/s2/s3）はローカルからの接続用でサーバー間通信には使えないため、
# サーバー同士が互いを参照する設定にはIPアドレスが必要になる。
S1_IP_ADDRESS="XXX.XXX.XXX.XXX"
S2_IP_ADDRESS="XXX.XXX.XXX.XXX"
S3_IP_ADDRESS="XXX.XXX.XXX.XXX"
